<idea-plugin>
    <id>com.github.mkslanc.intellijshexhighlighter</id>
    <name>ShEx Syntax Highlighter</name>
    <vendor>mkslanc</vendor>
    <description><![CDATA[
        <p>Adds syntax highlighting for Shape Expressions Compact Syntax (ShExC) files.</p>
        <p>The plugin recognizes <code>.shex</code> files and highlights directives, keywords,
        IRIs, prefixed names, shape references, literals, comments, and operators.</p>
    ]]></description>

    <idea-version since-build="252"/>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="ShEx"
                language="ShEx"
                extensions="shex"
                implementationClass="com.github.mkslanc.intellijshexhighlighter.ShExFileType"
                fieldName="INSTANCE"/>
        <lang.syntaxHighlighterFactory
                language="ShEx"
                implementationClass="com.github.mkslanc.intellijshexhighlighter.highlighting.ShExSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.github.mkslanc.intellijshexhighlighter.highlighting.ShExColorSettingsPage"/>
    </extensions>
</idea-plugin>
